# Gift Up — gift card checkout (https://www.giftup.com/) — Site ID from Installation / embed code
VITE_GIFTUP_SITE_ID=

# Supabase — tables: `visitor_leads` (popup), `contact_messages` (Contact page)
# Project URL + publishable (sb_publishable_...) or legacy anon JWT from Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# EmailJS (https://www.emailjs.com/) — enables automatic thank-you emails to visitors.
# Copy this file to `.env` and fill in values. Restart the dev server after changes.

VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
# Template that emails the VISITOR: set "To Email" in the template to {{to_email}}
# Use {{to_name}}, {{email_body}} in the subject/body.
VITE_EMAILJS_TEMPLATE_VISITOR=
# Lead notifications to you (default giantmantech@gmail.com). Template "To Email" must be {{to_email}}.
VITE_EMAILJS_TEMPLATE_OWNER=
# Optional override for where lead notifications are sent
# VITE_OWNER_NOTIFICATION_EMAIL=
